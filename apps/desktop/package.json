{
  "name": "@hzc/desktop",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "Haizhu Infinity Canvas desktop shell (Electron)",
  "author": "Haizhu",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:dir": "electron-builder --dir",
    "package:dist": "electron-builder",
    "typecheck": "node --check main.cjs",
    "test": "echo \"no desktop unit tests yet\""
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.haizhu.infinitycanvas",
    "productName": "HaizhuInfinityCanvas",
    "executableName": "haizhu-infinity-canvas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "HaizhuInfinityCanvas-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HaizhuInfinityCanvas-${version}-${os}-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Haizhu <noreply@haizhu.ai>",
      "icon": "build/icons"
    },
    "portable": {
      "artifactName": "HaizhuInfinityCanvas-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "homepage": "https://github.com/HaizhuAI/HaizhuInfinityCanvas",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaizhuAI/HaizhuInfinityCanvas.git"
  },
  "license": "UNLICENSED"
}
