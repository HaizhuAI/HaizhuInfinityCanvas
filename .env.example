# Copy to .env for docker compose. Choose ONE of the two ways to run it:

# (A) One person / a small team sharing one workspace: an access token, at least 16 random
#     characters, e.g. the output of `openssl rand -hex 24`. The server refuses this example value.
HZC_TOKEN=change-me-to-a-long-random-string

# (B) A website where people sign up for their own private workspace (docs/03-guide/saas-deployment.md):
#     remove HZC_TOKEN above and set
# HZC_ACCOUNTS=1
# HZC_ALLOWED_HOSTS=canvas.example.com
# HZC_TRUST_PROXY=1
# HZC_HSTS=1
# HZC_SECURE_COOKIES=1
# HZC_SIGNUP=open
# HZC_USER_QUOTA_MB=2048

# Behind a reverse proxy with HTTPS (see docs/03-guide/projects-and-desktop.md, 安全部署清单):
# HZC_ALLOWED_HOSTS=canvas.example.com
# HZC_TRUST_PROXY=1
# HZC_HSTS=1

# 1 (default here): model endpoints / result links may not point into this host or the LAN.
# Set to 0 if your models run locally (e.g. Ollama on the same machine).
# HZC_BLOCK_PRIVATE_NETWORK=1

# Database backups: every N hours, keep the newest M (defaults 6 / 14)
# HZC_BACKUP_HOURS=6
# HZC_BACKUP_KEEP=14
